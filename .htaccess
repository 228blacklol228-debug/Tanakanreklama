# Кодировка
AddDefaultCharset UTF-8

# Сжатие Gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

# Кэширование
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 day"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 6 months"
</IfModule>

# Безопасность
Options -Indexes
ServerSignature Off

# Редирект www → без www (раскомментируйте и замените домен)
# RewriteEngine On
# RewriteCond %{HTTP_HOST} ^www\.tankan\.ru [NC]
# RewriteRule ^(.*)$ https://tankan.ru/$1 [R=301,L]
